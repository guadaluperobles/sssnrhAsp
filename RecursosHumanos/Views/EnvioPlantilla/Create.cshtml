@model RecursosHumanos.Models.EnvioPlantilla
@{
    ViewData["Title"] = "Crear EnvioPlantilla";
}

<div class="row">
    <div class="col-8"><h4>Nuevo Envío de Plantilla</h4></div>
    <div class="col-4 text-end">
        <a class="btn btn-light" asp-action="Index">Volver</a>
    </div>
</div>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="Id" class="form-label"></label>
        <input asp-for="Id" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Correo" class="form-label"></label>
        <input asp-for="Correo" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Plantilla" class="form-label"></label>
        <input asp-for="Plantilla" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Titulo" class="form-label"></label>
        <input asp-for="Titulo" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Responsable" class="form-label"></label>
        <input asp-for="Responsable" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="descripcion" class="form-label"></label>
        <textarea asp-for="descripcion" class="form-control"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Guardar</button>
</form>
