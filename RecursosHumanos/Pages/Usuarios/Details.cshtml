@page "{id}"
@model RecursosHumanos.Pages.Usuarios.DetailsModel
@{
    ViewData["Title"] = "Detalles de usuario";
}

<div class="container">
    <h2>Detalles</h2>
    <dl class="row">
        <dt class="col-sm-2">Id</dt>
        <dd class="col-sm-10">@Model.UserItem?.Id</dd>

        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.UserItem?.Email</dd>

        <dt class="col-sm-2">Email confirmado</dt>
        <dd class="col-sm-10">@Model.UserItem?.EmailConfirmed</dd>
    </dl>
    <a asp-page="Index" class="btn btn-light">Volver</a>
</div>
