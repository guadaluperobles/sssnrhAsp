@{
    /*model IEnumerable<RecursosHumanos.Models.Cheque>*/
    /*modelView IEnumerable<RecursosHumanos.Models.Cheque>*/
}

@{
    ViewData["Title"] = "Impresión de Cheques";
    var datos = ((IEnumerable<object>)Model.Cheques.Datos);
    
    var Pendientes = new CustomTable
    {
        Datos = datos.Where(x =>
        {
            var valor = x.GetType().GetProperty("impreso")?.GetValue(x);
            return Convert.ToInt32(valor) == 0;
        }),
        Columnas = Model.Cheques.Columnas,
        Acciones = new List<CustomTableAction>{
            new CustomTableAction{
                Titulo = "Editar",
                Action = "Edit",
                Controller = "Cheque",
                Clase = "btn btn-info",
                Icono = "bi bi-pencil-fill"
            },
            new CustomTableAction{
                Titulo = "Impresion de Cheque",
                Action = "js",
                Href ="verModalImpresion({Id}, 'cheque')",
                Controller = "Cheque",
                Clase = "btn btn-warning",
                Icono = "bi bi-printer-fill"
            },
            new CustomTableAction{
                Titulo = "Impresión de Documento de firma",
                Action = "js",
                Href ="verModalImpresion({Id}, 'firmas')",
                Controller = "Cheque",
                Clase = "btn btn-warning",
                Icono = "bi bi-printer-fill"
            },
            new CustomTableAction{
                Titulo = "Eliminar",
                Action = "Delete",
                Controller = "Cheque",
                Clase = "btn btn-delete",
                Icono = "bi bi-trash"
            },
        }
    };

    var ImpresosPA = new CustomTable
    {
        Datos = datos.Where(x =>
        {
            var valor = x.GetType().GetProperty("impreso")?.GetValue(x);
            var tipoCheque = x.GetType().GetProperty("TipoCheque")?.GetValue(x);

            return Convert.ToInt32(valor) == 1
                && tipoCheque?.ToString() == "PensionAlimenticia";
        }),
        Columnas = Model.Cheques.Columnas,
        Acciones = new List<CustomTableAction>{
            new CustomTableAction{
                Titulo = "Impresion de Cheque",
                Action = "js",
                Href ="verModalImpresion({Id}, 'cheque')",
                Controller = "Cheque",
                Clase = "btn btn-warning",
                Icono = "bi bi-printer-fill"
            },
            new CustomTableAction{
                Titulo = "Impresión de Documento de firma",
                Action = "js",
                Href ="verModalImpresion({Id}, 'firmas')",
                Controller = "Cheque",
                Clase = "btn btn-warning",
                Icono = "bi bi-printer-fill"
            },
        }
    };

    var ImpresosCh = new CustomTable
    {
        Datos = datos.Where(x =>
        {
            var valor = x.GetType().GetProperty("impreso")?.GetValue(x);
            var tipoCheque = x.GetType().GetProperty("TipoCheque")?.GetValue(x);

            return Convert.ToInt32(valor) == 1
                && tipoCheque?.ToString() == "Chequera";
        }),
        Columnas = Model.Cheques.Columnas,
        Acciones = new List<CustomTableAction>{
            new CustomTableAction{
                Titulo = "Impresion de Cheque",
                Action = "js",
                Href ="verModalImpresion({Id}, 'cheque')",
                Controller = "Cheque",
                Clase = "btn btn-warning",
                Icono = "bi bi-printer-fill"
            },
            new CustomTableAction{
                Titulo = "Impresión de Documento de firma",
                Action = "js",
                Href ="verModalImpresion({Id}, 'firmas')",
                Controller = "Cheque",
                Clase = "btn btn-warning",
                Icono = "bi bi-printer-fill"
            },
        }
    };

    var camposTexto = $@"
        <div class='col-md-2'>
            <div class='form-group' style='text-align:left' >
                <labelclass='control-label'>Ejercicio</label>
                <input asp-for='Ejercicio' value='{Model.Ejercicio}' class='form-control' />
            </div>
        </div>
        <div class='col-md-2'>
            <div class='form-group' style='text-align:left'>
                <label class='control-label'>Quincena</label>
                <input asp -for= 'Quincena' value = '{Model.Quincena}' class= 'form-control' />
            </div>
        </div>
        <div class='col-md-2'>
            <div class='form-group' style='text-align:left'>
                <label class='control-label'>Numero de Cheque</label>
                <input asp -for= 'NumeroCheque' value = '{Model.UltimoDigito}' class= 'form-control' />
            </div>
        </div>
    ";
    var data = new ViewDataDictionary(ViewData)
    {
        { "Controller", "Cheque"},
        { "Action", "Importar"},
        { "Texto", "Importar"},
        { "ExtraParams", camposTexto}
    };
}


@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var modal = document.getElementById('modalReporte');

            if (modal) {
                modal.addEventListener('hidden.bs.modal', function () {
                    location.reload();
                });
            }
        });

        function verModalImpresion(id, tipo) {
            $("#modalReporte").modal("show");

            if(tipo == "cheque")
                $("#contenidoReporte").html(
                    '<iframe ' +
                    'src="/Cheque/GenerarReporteCheque?id=' + id + '" ' +
                    'width="100%" ' +
                    'height="700px" ' +
                    'frameborder="0">' +
                    '</iframe>'
                );

            if(tipo === "firmas")
                $("#contenidoReporte").html(
                    '<iframe ' +
                    'src="/Cheque/GenerarReporteFirmas?id=' + id + '" ' +
                    'width="100%" ' +
                    'height="700px" ' +
                    'frameborder="0">' +
                    '</iframe>'
                );

            if(tipo === "chequera")
                $("#contenidoReporte").html(
                    '<iframe ' +
                    'src="/Cheque/GenerarReporteFirmas?id=' + id + '&tipo=chequera" ' +
                    'width="100%" ' +
                    'height="700px" ' +
                    'frameborder="0">' +
                    '</iframe>'
                );

        }
    </script>
}
<partial name="_ModalReporte" />
<div class="container">
    <div class="row">
        <div class="col-md-12" style="text-align: end">
            <button type="button"
                    class="btn btn-secondary"
                    onclick="location.href='@Url.Action("Create")'">
                Agregar
            </button>
            <a class="btn btn-secondary"
               data-bs-toggle="collapse"
               href="#collapseImport"
               role="button"
               aria-expanded="false"
               aria-controls="collapseImport">
                Agregar archivo
            </a>
            <div class="collapse" id="collapseImport">
                <div class="card card-body">
                    <partial name="_ArchivoExportar" view-data="data" />
                </div>
            </div>
        </div>
        <div class="clearfix"></div>
        <div class="col-md-12">
            <ul class="nav nav-tabs" id="myTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="home-tab" data-bs-toggle="tab" data-bs-target="#pendientes-tab-pane" type="button" role="tab" aria-controls="home-tab-pane" aria-selected="true">Pendientes</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="profile-tab" data-bs-toggle="tab" data-bs-target="#impresos-pa-tab-pane" type="button" role="tab" aria-controls="profile-tab-pane" aria-selected="false">Impresos Pensión Alimenticia</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="profile-tab" data-bs-toggle="tab" data-bs-target="#impresos-ch-tab-pane" type="button" role="tab" aria-controls="profile-tab-pane" aria-selected="false">Impresos Chequera</button>
                </li>
            </ul>
            <div class="tab-content" id="myTabContent">
                <div class="tab-pane fade show active" id="pendientes-tab-pane" role="tabpanel" aria-labelledby="home-tab" tabindex="0">
                    <partial name="_CustomTabla" model="Pendientes" /> 
                </div>
                <div class="tab-pane fade" id="impresos-pa-tab-pane" role="tabpanel" aria-labelledby="profile-tab" tabindex="0">
                    <partial name="_CustomTabla" model="ImpresosPA" />
                </div>
                <div class="tab-pane fade" id="impresos-ch-tab-pane" role="tabpanel" aria-labelledby="profile-tab" tabindex="0">
                    <partial name="_CustomTabla" model="ImpresosCh" />
                </div>
            </div>
        </div>
    </div>
</div>

