@using System.Data
@*
    Tabla generica que manda los datos con paginador
*@
@model CustomTable

@if (Model?.Datos != null && Model.Datos.Any()  && Model.Columnas != null && Model.Columnas.Any())
{
    var llave = Model.Columnas.FirstOrDefault(x => x.Pk);
    <table class="table">
        <thead>
            <tr>
                @foreach (var columna in Model.Columnas)
                {
                    if (columna.Visible)
                    {
                        <th>@columna.Titulo</th>
                    }
                }
                @if (llave != null)
                {
                    <th></th>
                }
            </tr>
        </thead>

        <tbody>
            @{
                var pk = Model.Columnas.FirstOrDefault(c => c.Pk);
            }

            @if (Model.Datos.First() is DataRow)
            {
                @foreach (DataRow fila in Model.Datos)
                {
                    <tr onclick="seleccionarRegistro('@fila[pk.Propiedad]')" style="cursor:pointer">
                        @foreach (var columna in Model.Columnas.Where(c => c.Visible))
                        {
                            <td>@fila[columna.Propiedad]</td>
                        }
                    </tr>
                }
            }
            else
            {
                @foreach (var item in Model.Datos)
                {
                    var id = llave == null ? null : item.GetType().GetProperty(llave.Propiedad)?.GetValue(item);
                    <tr>
                        @foreach (var columna in Model.Columnas)
                        {
                            var valor = item.GetType().GetProperty(columna.Propiedad)?.GetValue(item);
                            if (columna.Visible)
                            {
                                <td>@valor</td>
                            }
                        }

                        @if (id != null)
                        {
                            <td class="td-actions">
                                <a class="btn btn-edit" asp-action="Edit" asp-route-id="@id">
                                    <i class="bi bi-pencil"></i>Editar
                                </a>
                                <a class="btn btn-edit"
                                   href="javascript:void(0);"
                                   onclick="verModalImpresion(@id)">
                                    <i class="bi bi-pencil"></i> Imprimir
                                </a>
                                <a class="btn btn-delete" asp-action="Delete" asp-route-id="@id">
                                    <i class="bi bi-trash"></i> Eliminar
                                </a>
                            </td>
                        }
                    </tr>
                }
            }
        </tbody>
    </table>
    <div class="mt-3">
        @if (Model.PaginaActual > 1)
        {
            <a asp-route-pagina="@(Model.PaginaActual - 1)">
                Anterior
            </a>
        }
        <span>
            Página @Model.PaginaActual de @Model.TotalPaginas
        </span>
        @if (Model.PaginaActual < Model.TotalPaginas)
        {
            <a asp-route-pagina="@(Model.PaginaActual + 1)">
                Siguiente
            </a>
        }
    </div>
}
else
{
    <div class="col-12" style="
        padding: 26px;
        margin-top: 15vh;
        ">
        <div class="alert alert-info" role="alert">
            No se encontraron datos
        </div>
    </div>
}
