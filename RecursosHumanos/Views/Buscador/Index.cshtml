@model RecursosHumanos.ViewModel.EmpleadosViewModel
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Buscar información de Empleado";
}
<div class="container">
    <div class="row">
        <div class="col-lg-6">
            <partial name="_Form" />
            <div class="clearfix"></div>
            <partial name="_CustomTabla" model="Model.Empleados" />
        </div>
        <div class="col-lg-6">
            <partial name="_Detalles" />
        </div>
    </div>
</div>

<script>
    function seleccionarRegistro(pk, baseDatos) {
        console.log(baseDatos)
        $.ajax({
            url: '/Buscador/Procesar',
            type: 'POST',
            data: {
                id: pk,
            },
            success: function (r) {
                console.log("Respuesta:", r.empleado);
                if(r.success == true && r.encontrado === true){
                    var empleado = r?.empleado;
                    
                    var fechaIngresoDependencia =  new Date(
                        Number(empleado?.MeFechIRam.substring(0, 4)),
                        Number(empleado?.MeFechIRam.substring(4, 6)) - 1,
                        Number(empleado?.MeFechIRam.substring(6, 8))
                    ).toLocaleDateString('es-MX');  

                    var fechaIngresoFederal =  new Date(
                        Number(empleado?.MeFechIIst.substring(0, 4)),
                        Number(empleado?.MeFechIIst.substring(4, 6)) - 1,
                        Number(empleado?.MeFechIIst.substring(6, 8))
                    ).toLocaleDateString('es-MX'); 

                    
                    $("#nombre").val(empleado?.NombreCompleto);
                    $("#rfc").val(empleado?.MeRfc);
                    $("#curp").val(empleado?.MeCurp);
                    $("#puesto").val(empleado?.ptPtoSHCP ? empleado?.ptPtoSHCP  : empleado?.ClkPt);
                    $("#puestoNombre").val(empleado?.PtDsc1);
                    $("#ceTrabajoNo").val(empleado?.MeCTrab);
                    $("#ceTrabajo").val(empleado?.CtDsc);
                    $("#ceTrabajoRfc").val(empleado?.CtCLUES);
                    $("#cedisNo").val(empleado?.MeCTrabDist);
                    $("#cedis").val(empleado?.MeCTrabDist);
                    $("#cedisRfc").val(empleado?.MeCTrabDist);
                    $("#unidad").val(empleado?.MeUAdmva);
                    $("#programa").val(empleado?.MeRfc);
                    $("#ingresoDependencia").val(fechaIngresoDependencia);
                    $("#ingresoGobiernoFederal").val(fechaIngresoFederal);
                    $("#clavePago").val(empleado?.MeClvPag);
                    $("#ramoPagaduria").val(empleado?.MeRfc);
                    $("#claveCentroTrabajo").val(empleado?.MeRfc);
                    $("#satCp").val(empleado?.MeSATCPost);
                    $("#satNombre").val(empleado?.MeSATNomEmp);
                }
                else{
                    alert("PK: " + r.mensaje);
                }
            },
            error: function (xhr) {
                console.error("Error:", xhr.responseText);
            }
        });
    }
</script>