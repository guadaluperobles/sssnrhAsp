@using (Html.BeginForm("TransparenciaIX", "Transparencia", FormMethod.Post))
{
        <div class="row">
            <div class="col-3">
                <label>Ejercicio:</label>
                <partial name="_SelectEjercicio" view-data="ViewData" />
            </div>
            <div class="col-3">
                <partial name="_SelectTrimestre" view-data="ViewData" />
            </div>
            <div class="col-1">
                <button type="submit" class="form-control btn-primary">Buscar</button>
            </div>
        </div>
}
