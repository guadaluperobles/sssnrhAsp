@model RecursosHumanos.Models.TipoNota
@{
    ViewData["Title"] = "Editar Tipo de nota";
}

<form asp-controller="TipoNotas" asp-action="Edit" method="post">
    <div class="row">
        <input asp-for="Id" type="hidden" />
        <div class="col-9">
            <div class="form-group">
                <label asp-for="Nombre"></label>
                <input asp-for="Nombre" class="form-control" />
            </div>
        </div>
        <div class="col-3">
            <partial name="_InputColor" />
        </div>

        <div class="col-6">
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-controller="TipoNotas" asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </div>
    </div>
</form>
<script type="text/javascript">
        document.getElementById('ColorPicker').addEventListener('input', function () {

        var hex = this.value;

        var r = parseInt(hex.substring(1, 3), 16);
        var g = parseInt(hex.substring(3, 5), 16);
        var b = parseInt(hex.substring(5, 7), 16);

        document.getElementById('ColorR').value = r;
        document.getElementById('ColorG').value = g;
        document.getElementById('ColorB').value = b;
    });
</script>