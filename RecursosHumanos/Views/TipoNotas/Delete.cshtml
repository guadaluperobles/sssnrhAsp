@model RecursosHumanos.Models.TipoNota

<h2>Eliminar Tipo de Nota</h2>

<div>
    <h4>¿Está seguro que desea eliminar este tipo de nota?</h4>
    <dl class="row">
        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.Nombre</dd>
    </dl>

    <form asp-controller="TipoNotas" asp-action="Delete" method="post">
        <input asp-for="Id" type="hidden" />
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a asp-controller="TipoNotas" asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
