<form asp-action="Index" id="frmBuscar" method="post">
    <div class="row">
        <div class="col-md-10">
            <div class="form-group">
                <label class="control-label">Localizar</label>
                <input id="localizar" name="localizar" class="form-control" value="@Model.Localizar" />
            </div>
        </div>
        <div class="col-md-2">
            <div class="form-group">
                <div class="switch-container">
                    <input type="checkbox"  class="switch-input"  id="activo" name="activo" checked>
                    <label class="switch-label" for="activo">
                        <span class="switch-text activo-text">Activo</span>
                        <span class="switch-text inactivo-text">Inactivo</span>
                    </label>
                </div>
            </div>
        </div>
    </div>
</form>

<script>
    document.getElementById("localizar")
        .addEventListener("change", function () {
            document.getElementById("frmBuscar").submit();
        });

        const checkbox = document.getElementById("activo"); 
        const texto = document.getElementById("textoActivo"); 
        checkbox.addEventListener("change", function () { 
            texto.textContent = this.checked ? "Activo" : "Inactivo"; 
        });
</script>