@model RecursosHumanos.ViewModel.EmpleadosViewModel
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Buscar información de Empleado";
}
<div class="container">
    <div class="row">
        <div class="col-lg-6">
            <partial name="_Form" />
            <div class="clearfix"></div>
            <partial name="_CustomTabla" model="Model.Empleados" />
        </div>
        <div class="col-lg-6">
            <partial name="_Detalles" />
        </div>
    </div>
</div>

<script>
    function seleccionarRegistro(pk) {
        $.ajax({
            url: '/Buscador/Procesar',
            type: 'POST',
            data: {
                id: pk,
            },
            success: function (r) {
                console.log("Respuesta:", r.empleado);
                if(r.success == true && r.encontrado === true){
                    var empleado = r?.empleado;
                    $("#nombre").val(empleado?.NombreCompleto);
                    $("#rfc").val(empleado?.MeRfc);
                    $("#curp").val(empleado?.MeRfc);
                    $("#puesto").val(empleado?.MePuesto);
                    $("#puestoNombre").val(empleado?.MePuesto);
                    $("#ceTrabajoNo").val(empleado?.MeCTrab);
                    $("#ceTrabajo").val(empleado?.MeCTrab);
                    $("#ceTrabajoRfc").val(empleado?.MeCTrab);
                    $("#cedisNo").val(empleado?.MeCTrabDist);
                    $("#cedis").val(empleado?.MeCTrabDist);
                    $("#cedisRfc").val(empleado?.MeCTrabDist);
                    $("#unidad").val(empleado?.MeRfc);
                    $("#programa").val(empleado?.MeRfc);
                    $("#ingresoDependencia").val(empleado?.MeRfc);
                    $("#ingresoGobiernoFederal").val(empleado?.MeRfc);
                    $("#clavePago").val(empleado?.MeClvPag);
                    $("#ramoPagaduria").val(empleado?.MeRfc);
                    $("#claveCentroTrabajo").val(empleado?.MeRfc);
                    $("#satCp").val(empleado?.MeRfc);
                    $("#satNombre").val(empleado?.MeRfc);
                }
                else{
                    alert("PK: " + r.mensaje);
                }
            },
            error: function (xhr) {
                console.error("Error:", xhr.responseText);
            }
        });
    }
</script>