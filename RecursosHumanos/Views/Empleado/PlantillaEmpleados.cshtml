@{
    ViewData["Title"] = "Plantilla Empleados";
}
<form method="post" asp-controller="Empleado" asp-action="PlantillaEmpleados">
    <div class="row  align-items-end">
        <div class="col-md-8">
            <partial name="_SelectCentroTrabajo"/>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary">
                Buscar
            </button>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-excel mt-4" asp-action="PlantillaEmpleadosExcel">
                <i class="bi bi-file-earmark-excel-fill"></i>
                Descargar Excel
            </button>
        </div>
    </div>
</form>
<partial name="_Tabla" model="Model" />