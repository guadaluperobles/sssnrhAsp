@using System.Data
@model System.Data.DataTable
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@using (Html.BeginForm("BuscarRecibos", "Index", FormMethod.Post)){
<div class="container">
    <div class="row">
        <div class="col-3">
            <label>Número de Empleado / RFC</label>
            <input class="form-control" type="text" name="numeroEmpleado"/>
        </div>
        <div class="col-4" style="text-align:center">
            <label style ="text-align: center">Ejercicio</label>
            <div class="row">
                <div class="col-6">
                    <label>Desde</label>
                    <input class="form-control" type="text" name="ejercicioInicio"/>
                </div>
                <div class="col-6">
                    <label>Hasta</label>
                    <input class="form-control" type="text" name="ejercicioFin"/>
                </div>
            </div>
        </div>
        <div class="col-4" style="text-align:center">
            <label style="text-align: center">Quincena</label>
            <div class="row">
                <div class="col-6">
                    <label>Desde</label>
                    <input class="form-control" type="text" name="quincenaInicio"/>
                </div>
                <div class="col-6">
                    <label>Hasta</label>
                    <input class="form-control" type="text" name="quincenaFin"/>
                </div>
            </div>
        </div>
        <div class="col-1">
            <button type="submit" class="form-control btn-primary">Buscar</button>
        </div>
    </div>
</div>
}
@if (Model != null)
{
    <table class="table">
        <thead>
            <tr>
                @foreach (DataColumn col in Model.Columns)
                {
                    <th>@col.ColumnName</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (DataRow row in Model.Rows)
            {
                <tr>
                    @foreach (var item in row.ItemArray)
                    {
                        <td>@item</td>
                    }
                </tr>
            }
        </tbody>
    </table>
}