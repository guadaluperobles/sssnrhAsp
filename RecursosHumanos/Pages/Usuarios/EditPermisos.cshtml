@page "{id}"
@model RecursosHumanos.Pages.Usuarios.EditPermisosModel
@{
    ViewData["Title"] = "Editar Permisos";
}

<div class="container">
    <h2>Editar permisos de @Model.ModelData.Email</h2>
    <form method="post">
        <input type="hidden" asp-for="ModelData.UserId" />
        <div class="row">
            @for (int i = 0; i < Model.ModelData.Permisos.Count; i++)
            {
                <div class="col-md-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" asp-for="ModelData.Permisos[i].Selected" />
                        <label class="form-check-label">@Model.ModelData.Permisos[i].Nombre</label>
                    </div>
                </div>
            }
        </div>
        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-page="Index" class="btn btn-light">Volver</a>
        </div>
    </form>
</div>
