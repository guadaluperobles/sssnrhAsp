<form asp-action="SubirArchivos" method="post" enctype="multipart/form-data">
    <div class="mb-3">
        <label class="form-label">Selecciona archivos</label>
        <input type="file" name="archivos"class="form-control" multiple />
    </div>

    <button type="submit" class="btn btn-primary">
        Subir
    </button>
</form>
