@model RecursosHumanos.Models.TipoNota

<h2>Detalles Tipo de Nota</h2>

<dl class="row">
    <dt class="col-sm-2">Nombre</dt>
    <dd class="col-sm-10">@Model.Nombre</dd>

    <dt class="col-sm-2">Color</dt>
    <dd class="col-sm-10"><span style="display:inline-block;width:40px;height:20px;background-color:rgb(@Model.ColorR,@Model.ColorG,@Model.ColorB);"></span></dd>

    <dt class="col-sm-2">Creado</dt>
    <dd class="col-sm-10">@Model.Creado.ToLocalTime().ToString("g")</dd>

    <dt class="col-sm-2">Creado Por</dt>
    <dd class="col-sm-10">@Model.CreadoPor</dd>

    <dt class="col-sm-2">Editado</dt>
    <dd class="col-sm-10">@(Model.Editado.HasValue ? Model.Editado.Value.ToLocalTime().ToString("g") : "-")</dd>

    <dt class="col-sm-2">Editado Por</dt>
    <dd class="col-sm-10">@Model.EditadoPor</dd>
</dl>

<a asp-controller="TipoNotas" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
<a asp-controller="TipoNotas" asp-action="Index" class="btn btn-secondary">Volver</a>
