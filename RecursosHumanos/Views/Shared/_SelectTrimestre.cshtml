<label for="Trimestre">Trimestre:</label>
<select class="form-control" id="Trimestre" name="Trimestre">
    <option value="">Seleccione el Trimestre</option>
    <option value="1" selected="@(ViewBag.Trimestre == 1)">Primer Trimestre</option>
    <option value="2" selected="@(ViewBag.Trimestre == 2)">Segundo Trimestre</option>
    <option value="3" selected="@(ViewBag.Trimestre == 3)">Tercer Trimestre</option>
    <option value="4" selected="@(ViewBag.Trimestre == 4)">Cuarto Trimestre</option>
</select>