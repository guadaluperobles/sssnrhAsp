@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@using (Html.BeginForm((string)ViewBag.Accion, "Transparencia", FormMethod.Post))
{
    <div class="row align-items-end">
        <div class="col-2"></div>
        <div class="col-3">
            <label>Ejercicio:</label>
            <partial name="_SelectEjercicio" view-data="ViewData" />
        </div>
        <div class="col-3">
            <partial name="_SelectTrimestre" view-data="ViewData" />
        </div>
        <div class="col-2">
            <button type="submit" class="form-control btn-primary">
                <i class="bi bi-search"></i>
                Buscar
            </button>
        </div>
        <div class="col-2">
            <button type="submit" class="form-control btn btn-excel" asp-action="@ViewBag.AccionExcel">
                <i class="bi bi-file-earmark-excel-fill"></i>
                Descargar Excel
            </button>
        </div>
    </div>
}