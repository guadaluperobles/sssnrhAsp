@using System.Data
@model RecursosHumanos.Models.ConsultaRecibosViewModel
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Impresión de Recibos de Nomina";
}
<partial name="_Form" />
@if (Model.Recibos != null)
{
    <table class="table">
        <thead>
            <tr>
                <th>Base de Datos</th>
                <th>ClkPr_ClkDet</th>
                <th>PrAno</th>
                <th>PrQna</th>
                <th>UUID</th>
                <th>PrNeto</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (DataRow row in Model.Recibos.Rows)
            {
                <tr>
                    <td>@row["BaseDatos"]</td>
                    <td>@row["ClkPr_ClkDet"]</td>
                    <td>@row["PrAno"]</td>
                    <td>@row["PrQna"]</td>
                    <td>@row["PrUUID"]</td>
                    <td>@row["PrNeto"]</td>
                    <td>
                        <button type="button"
                                class="btn btn-primary btn-sm"
                                onclick="DescargarXML('@row["PrUUID"]')">
                            Ver
                        </button>

                        <a asp-action="Descargar"
                           asp-route-id="@row["PrXML"]"
                           class="btn btn-success btn-sm">
                            Descargar
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}