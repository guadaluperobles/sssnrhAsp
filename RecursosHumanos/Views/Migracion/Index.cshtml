    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
    <form asp-action="Index" method="post">
        <div class="row">
            <div class="col-4">
               <partial name="_selectbasesdatos"/>
            </div>
            <div class="col-4">
                <div class="form-group">
                    <label for="NumeroOrigen">Numero de Empleado Origen:</label>
                    <input type="text" class="form-control" id="NumeroOrigen" name="NumeroOrigen"  required />
                </div>
            </div>
            <div class="col-4">
                <div class="form-group">
                    <label for="NumeroDestino" class="form-control-label">Numero de Empleado Destino:</label>
                    <input type="text" class="form-control" id="NumeroDestino" name="NumeroDestino" accept=".csv" required />
                </div>
            </div>
            <div class="clearfix"><hr /></div>
            <div class="col-12" style="text-align: end">
                <button type="submit" class="btn btn-primary">Migrar Usuario</button>
            </div>
        </div>
    </form>
    @if (!string.IsNullOrEmpty(Model))
    {
        <div class="row">
            <div class="col-12">
                <div class="alert @(Model.Contains("ERROR") ? "alert-danger" : "alert-info")">
                    @Html.Raw(Model)
                </div>
            </div>
        </div>
    }
