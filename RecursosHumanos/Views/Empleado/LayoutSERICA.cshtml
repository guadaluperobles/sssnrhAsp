@{ViewData["Title"] = "Reporte SERICA";}
<div class="container">
    <form method="post" asp-controller="Empleado" asp-action="LayoutSERICA">
        <div class="row">
            <div class="col-md-6"></div>
                <div class="col-md-2">
                <partial name="_SelectEjercicio"
                         view-data='new ViewDataDictionary(ViewData)
                         {
                             ["Id"] = "EjercicioNomina",
                             ["Name"] = "EjercicioNomina"
                         }' />
            </div>
            <div class="col-md-2">
                <partial name="_SelectQuincena" view-data='new ViewDataDictionary(ViewData)
                         {
                             ["Id"] = "Quincena",
                             ["Name"] = "Quincena"
                         }' />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-excel mt-4">
                    <i class="bi bi-file-earmark-excel-fill"></i>
                    Descargar Excel
                </button>
            </div>
        </div>
    </form>
</div>
<div class="container">
    <partial name="_Tabla" model="Model"/>
</div>