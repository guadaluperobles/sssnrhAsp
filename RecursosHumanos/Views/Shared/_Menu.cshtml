@{
    var modulos = new List<MenuItem>
    {
        new MenuItem
        {
            Vista = "Buscador",Controlador = "Buscador"
        },
        new MenuItem
        {
            Vista = "Recibo de Nómina",Controlador = "ReciboNomina"
        },
        new MenuItem
        { 
            Vista = "Transparencia LGT65 ",Controlador = "Transparencia",
            SubModulos = new List<MenuItem>
            {
                new MenuItem    {   Vista = "Plazas Vacantes",                Controlador = "LGT65PlazasVacantesOcupadas" },
                new MenuItem    {   Vista = "Remuneraciones Brutas y Netas",        Controlador = "LGT65RemuredacionesBrutasNetas"},
                new MenuItem    {   Vista = "Personas Jubiladas y Pensionadas",     Controlador = "LGT65PersonasJuviladasPensionadas"}
            }
        }
    };
}

<ul class="nav nav-pills flex-column mb-auto">
    @foreach (var modulo in modulos)
    {
        var idCollapse = "collapse_" + modulo.Controlador;

        <li class="nav-item" style=" color: #efc4a3 !important;">

            @if (modulo.SubModulos != null && modulo.SubModulos.Any())
            {
                <a class="nav-link d-flex justify-content-between align-items-center"
                   data-bs-toggle="collapse"
                   href="#@idCollapse"
                   role="button"
                   aria-expanded="false"
                   aria-controls="@idCollapse"
                   style="color: #efc4a3;">

                    @modulo.Vista
                    <span>+</span>
                </a>

                <div class="collapse" id="@idCollapse">
                    <ul class="nav flex-column ms-3 mt-2">
                        @foreach (var sub in modulo.SubModulos)
                        {
                            <li class="nav-item">
                                <a class="nav-link "
                                   style="color: #efc4a3;"
                                   asp-controller="@sub.Controlador"
                                   asp-action="Index">
                                    @sub.Vista
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
            else
            {
                <a class="nav-link"
                   asp-controller="@modulo.Controlador"
                   asp-action="Index"
                   style="color: #efc4a3;">
                    @modulo.Vista
                </a>
            }

        </li>
    }
</ul>