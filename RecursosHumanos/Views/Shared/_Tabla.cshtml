@using System.Data
@model System.Data.DataTable
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@section Scripts {
<script>
    $(document).ready(function () {
        console.log("Validacion")
        $('#tablaDatos').DataTable({
            language: {
                url: '//cdn.datatables.net/plug-ins/2.3.4/i18n/es-MX.json'
            },
            pageLength: 25,
            responsive: true
        });
    });
</script>
}
@if (Model == null || Model.Rows.Count == 0)
{
    <p>No hay registros.</p>
}
else
{
    <table class="table" id="tablaDatos">
        <thead>
            <tr>
                @foreach (DataColumn columna in Model.Columns)
                {
                    <th>@columna.ColumnName</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (DataRow fila in Model.Rows)
            {
                <tr>
                    @foreach (var valor in fila.ItemArray)
                    {
                        <td>@valor</td>
                    }
                </tr>
            }
        </tbody>
    </table>
}
