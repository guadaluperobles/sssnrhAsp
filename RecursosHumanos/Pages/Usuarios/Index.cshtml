@page
@model RecursosHumanos.Pages.Usuarios.IndexModel
@{
    ViewData["Title"] = "Usuarios";
}

<div class="container">
    <h2>Usuarios</h2>
    <table class="table">
        <thead>
            <tr>
                <th>Email</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var user in Model.Users)
            {
                <tr>
                    <td>@user.Email</td>
                    <td>
                        <a asp-page="Details" asp-route-id="@user.Id" class="btn btn-sm btn-light">Detalles</a>
                        <a asp-page="EditRoles" asp-route-id="@user.Id" class="btn btn-sm btn-info">Roles</a>
                        <a asp-page="EditPermisos" asp-route-id="@user.Id" class="btn btn-sm btn-secondary">Permisos</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
