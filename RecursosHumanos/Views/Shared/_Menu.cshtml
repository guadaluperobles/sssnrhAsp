@{
    var modulos = new List<MenuItem>
    {
        new MenuItem
        {
            Vista = "Inicio", Controlador = ""
        },
        new MenuItem
        {
            Vista = "Buscador",Controlador = "Buscador"
        },
    };

    if (User.Identity?.IsAuthenticated == true)
    {
        modulos.Add(
            new MenuItem
            {
                Vista = "Recibo de Nómina",
                Controlador = "ReciboNomina"
            });
        modulos.Add(
            new MenuItem
            {
                Vista = "Cheques",
                Controlador = "Cheque"
            });
        modulos.Add(
        new MenuItem
        {
            Vista = "Reportes Nomina",
            Controlador = "ReporteNomina",
            SubModulos = new List<MenuItem>
            {
                new MenuItem    {   Vista = "ISRTP",                                                            Controlador = "ISRTP" },
                new MenuItem    {   Vista = "Detalle de percepciones y deducciones por tipo de nomina",         Controlador = "DetallePersepcionDeduccion"},
                new MenuItem    {   Vista = "Para validad Ctros de Trab por BD en Productos de Pago",           Controlador = "ValidarCentrosTrabajo"},
                new MenuItem    {   Vista = "Plantilla Sindicalizados",                                         Controlador = "PlantillaSindicalizados"}
            }
        });
        modulos.Add(
        new MenuItem
        {
            Vista = "Transparencia LGT65 ",
            Controlador = "Transparencia",
            SubModulos = new List<MenuItem>
            {
                new MenuItem    {   Vista = "Plazas Vacantes",                                                   Controlador = "TransparenciaIX" },
                new MenuItem    {   Vista = "Remuneraciones Brutas y Netas",                                     Controlador = "TransparenciaVII"},
                new MenuItem    {   Vista = "Personas Jubiladas y Pensionadas",                                  Controlador = "TransparenciaXL"}
            }
        });

        modulos.Add(
        new MenuItem
        {
            Vista = "Administración",
            Controlador = "Administracion",
            SubModulos = new List<MenuItem>
            {
                new MenuItem    {   Vista = "Notas",                                                           Controlador = "Nota" },
                new MenuItem    {   Vista = "Consultas SQL",                                                   Controlador = "Consultas" },
            }
        });
    }

}

<ul class="nav nav-pills flex-column mb-auto">
    @foreach (var modulo in modulos)
    {
        var idCollapse = "collapse_" + modulo.Controlador;

        <li class="nav-item" style=" color: #efc4a3 !important;">

            @if (modulo.SubModulos != null && modulo.SubModulos.Any())
            {
                <a class="nav-link d-flex justify-content-between align-items-center"
                   data-bs-toggle="collapse"
                   href="#@idCollapse"
                   role="button"
                   aria-expanded="false"
                   aria-controls="@idCollapse"
                   style="color: #efc4a3;">

                    @modulo.Vista
                    <span>+</span>
                </a>

                <div class="collapse" id="@idCollapse">
                    <ul class="nav flex-column ms-3 mt-2">
                        @foreach (var sub in modulo.SubModulos)
                        {
                            <li class="nav-item">
                                <a class="nav-link "
                                   style="color: #efc4a3;"
                                   asp-controller="@sub.Controlador"
                                   asp-action="Index">
                                    @sub.Vista
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
            else
            {
                <a class="nav-link"
                   asp-controller="@modulo.Controlador"
                   asp-action="Index"
                   style="color: #efc4a3;">
                    @modulo.Vista
                </a>
            }

        </li>
    }
</ul>