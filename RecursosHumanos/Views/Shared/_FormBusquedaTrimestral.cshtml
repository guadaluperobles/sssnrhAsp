@using RecursosHumanos.ViewModel
@model ConsultaTrimestralViewModel;
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    List<SelectListItem> Trimestre = new()
    {
        new SelectListItem {Value = "1", Text = "Primer Trimestre" },
        new SelectListItem {Value = "2", Text = "Segundo Trimestre" },
        new SelectListItem {Value = "3", Text = "Tercer Trimestre" },
        new SelectListItem {Value = "4", Text = "Cuarto Trimestre" },
    };
}
<form asp-action="Index" method="post">
    <div class="row">
        <div class="col-6"></div>
        <div class="col-md-2">
            <div class="form-group">
                <label class="control-label">Ejercicio</label>
                <input asp-for="Ejercicio" class="form-control" />
            </div>
        </div>
        <div class="col-md-2">
            <div class="form-group">
                <label class="control-label">Trimestre</label>
                <select asp-for="Trimestre"
                        asp-items="Trimestre"
                        onchange="cargarDatos(this.value)"
                        class="form-select">
                    <option value="">-- Seleccione un Semestre --</option>
                </select>
            </div>
        </div>
        <div class="col-md-2" style="text-align:end">
            <div class="form-group">
                <button type="submit" class="btn btn-secondary">
                    <i class="bi bi-search"></i>
                    Buscar
                </button>
                <button type="submit"
                        formmethod="post"
                        formaction="@Url.Action("ImportarExcel", Model.Controlador)"
                        class="btn btn-excel">
                    <i class="bi bi-file-earmark-excel-fill"></i>
                    Excel
                </button>
            </div>
        </div>
    </div>
</form>