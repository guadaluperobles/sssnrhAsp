@model RecursosHumanos.Models.PermisoVistaModel
@{
    ViewData["Title"] = "Detalles";
}

<div class="row">
    <div class="col-8"></div>
    <div class="col-4" style="text-align: end">
        <a class="btn btn-light" asp-action="Index">Volver</a>
    </div>
    <div class="col-12 mt-3">
        <dl class="row">
            <dt class="col-sm-2">Nombre</dt>
            <dd class="col-sm-10">@Model.Nombre</dd>

            <dt class="col-sm-2">Controller</dt>
            <dd class="col-sm-10">@Model.Controller</dd>

            <dt class="col-sm-2">Action</dt>
            <dd class="col-sm-10">@Model.Action</dd>

            <dt class="col-sm-2">Descripción</dt>
            <dd class="col-sm-10">@Model.Descripcion</dd>

            <dt class="col-sm-2">Activo</dt>
            <dd class="col-sm-10">@Model.Activo</dd>
        </dl>
    </div>
</div>
