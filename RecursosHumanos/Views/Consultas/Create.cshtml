@model RecursosHumanos.Models.Consultas
@{
    ViewData["Title"] = Model?.Id == null ? "Nueva Consulta" : "Editar Consulta";
}

<div class="container">
    <div class="row">
        <div class="col-8"></div>
        <div class="col-4" style="text-align: end">
            <a class="btn btn-light" asp-action="Index">Volver</a>
        </div>
    </div>
    <partial name="_Form" model="Model" />
</div>

