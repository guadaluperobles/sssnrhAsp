@using System.Data
@model RecursosHumanos.ViewModel.RecibosViewModel
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@section Scripts {
    <script>
        function verModalReciboNomina(uuid) {

            $("#modalReporte").modal("show");

            $("#contenidoReporte").html(
                '<iframe ' +
                'src="/ReciboNomina/GenerarReporte?UUID=' + uuid + '" ' +
                'width="100%" ' +
                'height="700px" ' +
                'frameborder="0">' +
                '</iframe>'
            );
        }
    </script>
}
@{
    ViewData["Title"] = "Impresión de Recibos de Nomina";

    var data = new ViewDataDictionary(ViewData)
    {
        { "Controller", "ReciboNomina"},
        { "Action", "Importar"},
        { "Texto", "Importar"}
    };
}

<partial name="_Form" />
<partial name="_ModalReporte" />
@if (Model.Recibos != null)
{
    <table class="table">
        <thead>
            <tr>
                <th>Base de Datos</th>
                <th>Ejercicio</th>
                <th>Quincena</th>
                <th>Producto</th>
                <th>UUID</th>
                <th>Neto</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (DataRow row in Model.Recibos.Rows)
            {
                <tr >
                    <td>@row["BaseDatos"]</td>
                    <td>@row["PrAno"]</td>
                    <td>@row["PrQna"]</td>
                    <td>@row["ClkPr"]</td>
                    <td>@row["PrUUID"]</td>
                    <td>@Convert.ToDecimal(row["PrNeto"]).ToString("N2")</td>
                    <td>
                        <button type="button" class="btn btn-primary btn-sm" onclick="verModalReciboNomina('@row["PrUUID"]')">
                            PDF
                        </button>
                        <a asp-action="Descargar" asp-route-id="@row["PrUUID"]" class="btn btn-success btn-sm">
                            XML
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}