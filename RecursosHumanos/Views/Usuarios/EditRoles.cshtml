@model RecursosHumanos.Models.UserRolesViewModel
@{
    ViewData["Title"] = "Editar Roles";
}

<div class="container">
    <h2>Editar roles de @Model.Email</h2>
    <form asp-action="EditRoles" method="post">
        <input type="hidden" asp-for="UserId" />
        <div class="row">
            @for (int i = 0; i < Model.Roles.Count; i++)
            {
                <div class="col-md-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" asp-for="Roles[i].Selected" />
                        <label class="form-check-label">@Model.Roles[i].RoleName</label>
                    </div>
                </div>
            }
        </div>
        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-light">Volver</a>
        </div>
    </form>
</div>
