@model RecursosHumanos.Models.TipoNota

<h2>Crear Tipo de Nota</h2>

<form asp-controller="TipoNotas" asp-action="Create" method="post">

    <div class="mb-9">
    <div class="form-group">
        <label asp-for="Nombre"></label>
        <input asp-for="Nombre" class="form-control" />
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label">Color</label>

        <input type="color"
               id="ColorPicker"
               value="#690141"
               class="form-control form-control-color"
               title="Seleccionar color">

        <input type="hidden" asp-for="ColorR" id="ColorR">
        <input type="hidden" asp-for="ColorG" id="ColorG">
        <input type="hidden" asp-for="ColorB" id="ColorB">
    </div>
    <button type="submit" class="btn btn-primary">Crear</button>
    <a asp-controller="TipoNotas" asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
