@using RecursosHumanos.ViewModel
@model ConsultaSemestralViewModel;
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    List<SelectListItem> Semestre = new()
    {
        new SelectListItem {Value = "1", Text = "Primer semestre" },
        new SelectListItem {Value = "2", Text = "Segundo semestre" },
        new SelectListItem {Value = "3", Text = "Seleccionar por meses" },
        new SelectListItem {Value = "4", Text = "Seleccionar por quincenas" },
    };
}
<form asp-action="Index" method="post">
    <div class="row">
        <div class="col-2"></div>
        <div class="col-4" id="compenzacion"></div>
        <div class="col-md-2">
            <div class="form-group">
                <label class="control-label">Ejercicio</label>
                <input asp-for="Ejercicio" class="form-control" />
            </div>
        </div>
        <div class="col-md-2">
            <div class="form-group">
                <label class="control-label">Semestre</label>
                <select asp-for="Semestre"
                        asp-items="Semestre"
                        onchange="cargarDatos(this.value)"
                        class="form-select">
                    <option value="">-- Seleccione un Semestre --</option>
                </select>
            </div>
        </div>
        <div class="col-md-2" id="inicial">
            <div class="form-group">
                <label class="control-label" id="LabelInicial"></label>
                <input asp-for="Inicial" class="form-control" />
            </div>
        </div>
        <div class="col-md-2" id="final">
            <div class="form-group">
                <label class="control-label" id="LabelFinal"></label>
                <input asp-for="Final" class="form-control" />
            </div>
        </div>
        <div class="col-md-2" style="text-align:end">
            <div class="form-group">
                <button type="submit" class="btn btn-secondary">
                    <i class="bi bi-search"></i>
                    Buscar
                </button>
                <button type="submit"
                        formmethod="post"
                        formaction="@Url.Action("ImportarExcel", Model.Controlador)"
                        class="btn btn-excel">
                    <i class="bi bi-file-earmark-excel-fill"></i>
                    Excel
                </button>
            </div>
        </div>
    </div>
</form>