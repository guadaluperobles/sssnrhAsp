@model RecursosHumanos.Models.EnvioPlantilla
@{
    ViewData["Title"] = "Eliminar EnvioPlantilla";
}

<h4>Eliminar</h4>
<div class="alert alert-warning">¿Desea eliminar este registro?</div>
<dl class="row">
    <dt class="col-sm-2">Id</dt>
    <dd class="col-sm-10">@Model.Id</dd>
    <dt class="col-sm-2">Correo</dt>
    <dd class="col-sm-10">@Model.Correo</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a class="btn btn-light" asp-action="Index">Cancelar</a>
</form>
