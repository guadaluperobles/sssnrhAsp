@using (Html.BeginForm((string)ViewBag.Accion, "Transparencia", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    <div class="row align-items-end">
        <div class="col-2">
            @if (ViewBag.SubirArchivo is bool subirArchivo && subirArchivo)
            {
                <a class="btn btn-secondary"
                   data-bs-toggle="collapse"
                   href="#collapseImport"
                   role="button"
                   aria-expanded="false"
                   aria-controls="collapseImport">
                    Agregar archivo
                </a>
            }
        </div>
        <div class="col-3">
            <label>Ejercicio:</label>
            <partial name="_SelectEjercicio" view-data="ViewData" />
        </div>
        <div class="col-3">
            <partial name="_SelectTrimestre" view-data="ViewData" />
        </div>
        <div class="col-2">
            <button type="submit" class="form-control btn-primary">
                <i class="bi bi-search"></i>
                Buscar
            </button>
        </div>
        <div class="col-2">
            <button type="submit" class="form-control btn btn-excel" asp-action="@ViewBag.AccionExcel">
                <i class="bi bi-file-earmark-excel-fill"></i>
                Descargar Excel
            </button>
        </div>
        <div class="collapse" id="collapseImport">
            <div class="card card-body">
                <div class="row align-items-end">
                    <div class="col-6"></div>

                    <div class="col-4">
                        <input type="file" name="archivo" class="form-control" />
                    </div>
                    <div class="col-2">
                        <button type="submit" class="btn btn-primary" style="width: 100%">
                            @(ViewData["Texto"] != null ? @ViewData["Texto"] : "Subir")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
