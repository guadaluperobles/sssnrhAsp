@model RecursosHumanos.Models.Nota

<h2>Detalles Nota</h2>

<dl class="row">
    <dt class="col-sm-2">Título</dt>
    <dd class="col-sm-10">@Model.Titulo</dd>

    <dt class="col-sm-2">Contenido</dt>
    <dd class="col-sm-10">@Model.Contenido</dd>

    <dt class="col-sm-2">Tipo</dt>
    <dd class="col-sm-10">@Model.TipoNota?.Nombre</dd>

    <dt class="col-sm-2">Para</dt>
    <dd class="col-sm-10">@(Model.EsParaTodos ? "Todos" : Model.UsuarioId)</dd>

    <dt class="col-sm-2">Fecha</dt>
    <dd class="col-sm-10">@Model.Fecha.ToLocalTime().ToString("g")</dd>

    <dt class="col-sm-2">Creado</dt>
    <dd class="col-sm-10">@Model.Creado.ToLocalTime().ToString("g")</dd>

    <dt class="col-sm-2">Creado Por</dt>
    <dd class="col-sm-10">@Model.CreadoPor</dd>

    <dt class="col-sm-2">Editado</dt>
    <dd class="col-sm-10">@(Model.Editado.HasValue ? Model.Editado.Value.ToLocalTime().ToString("g") : "-")</dd>

    <dt class="col-sm-2">Editado Por</dt>
    <dd class="col-sm-10">@Model.EditadoPor</dd>
</dl>

<a asp-controller="Notas" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
<a asp-controller="Notas" asp-action="Index" class="btn btn-secondary">Volver</a>
