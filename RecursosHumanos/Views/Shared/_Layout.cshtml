<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Recursos Humanos</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap-5.0.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-5.0.2/dist/css/sidebars.css" asp-append-version="true" />
    <script src="~/lib/bootstrap/dist/js/sidebars.js"></script>
    <link rel="stylesheet" href="~/RecursosHumanos.styles.css" asp-append-version="true" />
    <meta name="theme-color" content="#712cf9" />
</head>
<body>

    <partial name="_Loading" />
    <!-- Navbar -->
    <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <img src="~/images/LogoSalud.png"
                     asp-append-version="true"
                     style="width:250px" />
            </a>

            
            <nav aria-label="breadcrumb" style="text-align:start">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item active" aria-current="page">
                        <h4> @ViewData["Title"]</h4>
                        </li>
                </ol>
            </nav>
            <partial name="_LoginPartial" />
        </div>
    </nav>

    <!-- Contenido -->
    <div class="d-flex container-principal">

        <!-- Sidebar -->
        <div id="sidebar">
            <partial name="_Sidebar" />
        </div>

        <!-- Página -->
        <main class="flex-grow-1 p-4 container-rows ">
            @RenderBody()
        </main>

    </div>

    <footer class="border-top footer text-muted" style="background:#44152c">
        <div class="container-fluid text-center" style="color: #efc4a3;">
            &copy; 2026 | Secretaría de Salud Publica del Estado de Sonora - Recursos Humanos
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
