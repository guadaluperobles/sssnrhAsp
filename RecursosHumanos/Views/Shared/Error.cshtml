@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Error.</h1>
<h2 class="text-danger">
    No fue posible procesar la solicitud. Intenta nuevamente en unos momentos.

    Si el problema persiste, proporciona el siguiente ID al administrador:
</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Algo salió mal</h3>
<hr />
<p>
    Ocurrió un problema al procesar la solicitud. Por favor, intenta nuevamente en unos
    momentos.
</p>
<p>
    Si el problema continúa, comunícate con el administrador del sistema
    e indica el número de referencia que aparece a continuación.
</p>
<p> <strong>ID de referencia:</strong> @Model.RequestId </p>