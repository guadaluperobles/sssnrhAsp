@model RecursosHumanos.Models.EnvioPlantilla
@{
    ViewData["Title"] = "Detalles EnvioPlantilla";
}

<h4>Detalles</h4>
<dl class="row">
    <dt class="col-sm-2">Id</dt>
    <dd class="col-sm-10">@Model.Id</dd>

    <dt class="col-sm-2">Correo</dt>
    <dd class="col-sm-10">@Model.Correo</dd>

    <dt class="col-sm-2">Plantilla</dt>
    <dd class="col-sm-10">@Model.Plantilla</dd>

    <dt class="col-sm-2">Título</dt>
    <dd class="col-sm-10">@Model.Titulo</dd>

    <dt class="col-sm-2">Responsable</dt>
    <dd class="col-sm-10">@Model.Responsable</dd>

    <dt class="col-sm-2">Creado</dt>
    <dd class="col-sm-10">@Model.creado.ToString("g")</dd>
</dl>

<a class="btn btn-light" asp-action="Index">Volver</a>
