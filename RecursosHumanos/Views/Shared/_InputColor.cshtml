@using System.Data
@using RecursosHumanos.Data
@using RecursosHumanos.Model
@inject ConeccionService _coneccionService

@{
    Global global = new Global(_coneccionService);
    DataTable BasesDatos = global.BasesDatosOperativas();

    string baseDatosSeleccionada = ViewBag.BaseDatosConsulta?.ToString() ?? "";
}

<label class="form-label">Color</label>
<input type="color"
       id="ColorPicker"
       value="#690141"
       class="form-control form-control-color"
       title="Seleccionar color">

<input type="hidden" name="ColorR" id="ColorR">
<input type="hidden" name="ColorG" id="ColorG">
<input type="hidden" name="ColorB" id="ColorB">


<script type="text/javascript">
        document.getElementById('ColorPicker').addEventListener('input', function () {

        var hex = this.value;

        var r = parseInt(hex.substring(1, 3), 16);
        var g = parseInt(hex.substring(3, 5), 16);
        var b = parseInt(hex.substring(5, 7), 16);

        document.getElementById('ColorR').value = r;
        document.getElementById('ColorG').value = g;
        document.getElementById('ColorB').value = b;
    });
</script>