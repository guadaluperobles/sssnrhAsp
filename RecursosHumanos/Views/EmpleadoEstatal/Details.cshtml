@model RecursosHumanos.Models.EmpleadoEstatal
@{
    ViewData["Title"] = "Detalles EmpleadoEstatal";
}

<h4>Detalles</h4>
<dl class="row">
    <dt class="col-sm-2">Id</dt>
    <dd class="col-sm-10">@Model.Id</dd>

    <dt class="col-sm-2">Nombre</dt>
    <dd class="col-sm-10">@Model.nombre</dd>

    <dt class="col-sm-2">Paterno</dt>
    <dd class="col-sm-10">@Model.paterno</dd>

    <dt class="col-sm-2">Materno</dt>
    <dd class="col-sm-10">@Model.materno</dd>

    <dt class="col-sm-2">RFC</dt>
    <dd class="col-sm-10">@Model.rfc</dd>

    <dt class="col-sm-2">Creado</dt>
    <dd class="col-sm-10">@Model.creado.ToString("g")</dd>
</dl>

<a class="btn btn-light" asp-action="Index">Volver</a>
